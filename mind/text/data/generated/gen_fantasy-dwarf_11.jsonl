{"text": "Well met, stranger.", "intent": "GREET", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.4, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Welcome to the great hall, outsider.", "intent": "GREET", "topic": "HOME", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.5, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Good morning, Ragna.", "intent": "GREET", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.5, "urgency": 0.0, "names": ["Ragna"], "sincerity": "SINCERE"}
{"text": "Hail, friends!", "intent": "GREET", "topic": "CLAN", "addressed": "GROUP", "aggression": 0.0, "valence": 0.5, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Ah, Dagna, good to see you at the gate.", "intent": "GREET", "topic": "HOME", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.6, "urgency": 0.0, "names": ["Dagna"], "sincerity": "SINCERE"}
{"text": "Greetings, human. Mind the mud near the forge.", "intent": "GREET", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Halvar, you old goat, welcome back to the mine!", "intent": "GREET", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.6, "urgency": 0.0, "names": ["Halvar"], "sincerity": "JOKING"}
{"text": "Evening, all. Grab a stool by the fire.", "intent": "GREET", "topic": "HOME", "addressed": "GROUP", "aggression": 0.0, "valence": 0.4, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Farewell, and mind the road.", "intent": "FAREWELL", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Safe travels, Torvi.", "intent": "FAREWELL", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.5, "urgency": 0.0, "names": ["Torvi"], "sincerity": "SINCERE"}
{"text": "Tell Torvi I'll see her at supper.", "intent": "FAREWELL", "topic": "NONE", "addressed": "THIRD", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": ["Torvi"], "sincerity": "SINCERE"}
{"text": "Until the gate, friends.", "intent": "FAREWELL", "topic": "HOME", "addressed": "GROUP", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Goodnight, Sindri. Bar the door behind you.", "intent": "FAREWELL", "topic": "HOME", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": ["Sindri"], "sincerity": "SINCERE"}
{"text": "Off to bed. My axe needs sharpening tomorrow.", "intent": "FAREWELL", "topic": "WEAPON", "addressed": "NONE", "aggression": 0.0, "valence": 0.1, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Farewell, clan. May the ore run deep.", "intent": "FAREWELL", "topic": "CLAN", "addressed": "GROUP", "aggression": 0.0, "valence": 0.4, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Take care, Vidar.", "intent": "FAREWELL", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.5, "urgency": 0.0, "names": ["Vidar"], "sincerity": "SINCERE"}
{"text": "Cold morning for the farm again.", "intent": "SMALLTALK", "topic": "WORK", "addressed": "NONE", "aggression": 0.0, "valence": 0.0, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Frida's bread is better this week.", "intent": "SMALLTALK", "topic": "FOOD", "addressed": "THIRD", "aggression": 0.0, "valence": 0.2, "urgency": 0.0, "names": ["Frida"], "sincerity": "SINCERE"}
{"text": "I could kill for a pint right now.", "intent": "SMALLTALK", "topic": "DRINK", "addressed": "NONE", "aggression": 0.05, "valence": 0.1, "urgency": 0.0, "names": [], "sincerity": "JOKING"}
{"text": "Rain again. The tunnels will flood.", "intent": "SMALLTALK", "topic": "MINE", "addressed": "NONE", "aggression": 0.0, "valence": -0.1, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Brynja says the goats got out again.", "intent": "SMALLTALK", "topic": "WORK", "addressed": "THIRD", "aggression": 0.0, "valence": 0.1, "urgency": 0.0, "names": ["Brynja"], "sincerity": "SINCERE"}
{"text": "I could eat a whole boar right now, easily.", "intent": "SMALLTALK", "topic": "FOOD", "addressed": "NONE", "aggression": 0.0, "valence": 0.2, "urgency": 0.0, "names": [], "sincerity": "JOKING"}
{"text": "Steinar's beard is getting longer than his pickaxe.", "intent": "SMALLTALK", "topic": "WORK", "addressed": "THIRD", "aggression": 0.0, "valence": 0.2, "urgency": 0.0, "names": ["Steinar"], "sincerity": "JOKING"}
{"text": "Nice to see the whole clan together.", "intent": "SMALLTALK", "topic": "CLAN", "addressed": "GROUP", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Borin's buying rounds again tonight.", "intent": "SMALLTALK", "topic": "DRINK", "addressed": "THIRD", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": ["Borin"], "sincerity": "SINCERE"}
{"text": "Long shift at the mine today.", "intent": "SMALLTALK", "topic": "MINE", "addressed": "NONE", "aggression": 0.0, "valence": 0.0, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Gudrun's little one took his first steps.", "intent": "SMALLTALK", "topic": "HOME", "addressed": "THIRD", "aggression": 0.0, "valence": 0.4, "urgency": 0.0, "names": ["Gudrun"], "sincerity": "SINCERE"}
{"text": "Not much news.", "intent": "SMALLTALK", "topic": "NONE", "addressed": "NONE", "aggression": 0.0, "valence": 0.0, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "How deep does this tunnel go?", "intent": "QUESTION", "topic": "MINE", "addressed": "NONE", "aggression": 0.0, "valence": 0.1, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Is the forge still lit, Eitri?", "intent": "QUESTION", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.0, "names": ["Eitri"], "sincerity": "SINCERE"}
{"text": "What's for supper?", "intent": "QUESTION", "topic": "FOOD", "addressed": "GROUP", "aggression": 0.0, "valence": 0.1, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Has Vidar seen my pickaxe?", "intent": "QUESTION", "topic": "WEAPON", "addressed": "THIRD", "aggression": 0.0, "valence": 0.0, "urgency": 0.1, "names": ["Vidar"], "sincerity": "SINCERE"}
{"text": "Do we have enough gold for the trade, Dvalin?", "intent": "QUESTION", "topic": "TRADE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.0, "urgency": 0.2, "names": ["Dvalin"], "sincerity": "SINCERE"}
{"text": "Who's on watch at the gate tonight?", "intent": "QUESTION", "topic": "HOME", "addressed": "GROUP", "aggression": 0.0, "valence": 0.0, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Well?", "intent": "QUESTION", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.1, "valence": -0.1, "urgency": 0.3, "names": [], "sincerity": "SINCERE"}
{"text": "Has Borin come back from the trade route yet?", "intent": "QUESTION", "topic": "TRADE", "addressed": "THIRD", "aggression": 0.0, "valence": -0.1, "urgency": 0.0, "names": ["Borin"], "sincerity": "SINCERE"}
{"text": "Are the spiders back in the lower tunnels, Ragna?", "intent": "QUESTION", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.0, "valence": -0.1, "urgency": 0.3, "names": ["Ragna"], "sincerity": "SINCERE"}
{"text": "Skadi, why is the axe rack empty?", "intent": "QUESTION", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.2, "valence": -0.1, "urgency": 0.1, "names": ["Skadi"], "sincerity": "SINCERE"}
{"text": "Could you pass the bread, Frida?", "intent": "REQUEST", "topic": "FOOD", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.3, "urgency": 0.1, "names": ["Frida"], "sincerity": "SINCERE"}
{"text": "Fetch me another pickaxe from the shed, would you?", "intent": "REQUEST", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Could you send word to Torvi about the forge?", "intent": "REQUEST", "topic": "FORGE", "addressed": "THIRD", "aggression": 0.0, "valence": 0.2, "urgency": 0.2, "names": ["Torvi"], "sincerity": "SINCERE"}
{"text": "Round of ale?", "intent": "REQUEST", "topic": "DRINK", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Sharpen this for me before dusk, Orm.", "intent": "REQUEST", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.1, "urgency": 0.4, "names": ["Orm"], "sincerity": "SINCERE"}
{"text": "Could someone check on the goats?", "intent": "REQUEST", "topic": "WORK", "addressed": "GROUP", "aggression": 0.0, "valence": 0.1, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Spare a coin for an old miner?", "intent": "REQUEST", "topic": "TREASURE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.0, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Would you trade me that pickaxe, stranger?", "intent": "REQUEST", "topic": "TRADE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.1, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Help me carry this ore up, will you, Borin?", "intent": "REQUEST", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.1, "urgency": 0.2, "names": ["Borin"], "sincerity": "SINCERE"}
{"text": "Bring more torches down, please.", "intent": "REQUEST", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.1, "urgency": 0.3, "names": [], "sincerity": "SINCERE"}
{"text": "Everyone to the gate, now!", "intent": "COMMAND", "topic": "HOME", "addressed": "GROUP", "aggression": 0.3, "valence": 0.0, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Move.", "intent": "COMMAND", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.4, "valence": -0.1, "urgency": 0.7, "names": [], "sincerity": "SINCERE"}
{"text": "Douse the forge fire before you leave.", "intent": "COMMAND", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.0, "urgency": 0.5, "names": [], "sincerity": "SINCERE"}
{"text": "Grab your axes, all of you.", "intent": "COMMAND", "topic": "WEAPON", "addressed": "GROUP", "aggression": 0.3, "valence": 0.0, "urgency": 0.6, "names": [], "sincerity": "SINCERE"}
{"text": "Bar the gate and stay inside.", "intent": "COMMAND", "topic": "HOME", "addressed": "GROUP", "aggression": 0.2, "valence": 0.0, "urgency": 0.8, "names": [], "sincerity": "SINCERE"}
{"text": "Tell Halvar to load the cart before nightfall.", "intent": "COMMAND", "topic": "MINE", "addressed": "THIRD", "aggression": 0.1, "valence": 0.0, "urgency": 0.5, "names": ["Halvar"], "sincerity": "SINCERE"}
{"text": "Sindri, stand watch.", "intent": "COMMAND", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.0, "urgency": 0.4, "names": ["Sindri"], "sincerity": "SINCERE"}
{"text": "Shouldn't you all be back at work?", "intent": "COMMAND", "topic": "WORK", "addressed": "GROUP", "aggression": 0.3, "valence": -0.1, "urgency": 0.3, "names": [], "sincerity": "SARCASTIC"}
{"text": "Hand it over.", "intent": "COMMAND", "topic": "TREASURE", "addressed": "LISTENER", "aggression": 0.4, "valence": -0.2, "urgency": 0.4, "names": [], "sincerity": "SINCERE"}
{"text": "Stand down, Vidar.", "intent": "COMMAND", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.3, "valence": -0.1, "urgency": 0.5, "names": ["Vidar"], "sincerity": "SINCERE"}
{"text": "Take this loaf, Kolbrun, you look hungry.", "intent": "OFFER", "topic": "FOOD", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.4, "urgency": 0.0, "names": ["Kolbrun"], "sincerity": "SINCERE"}
{"text": "I'll trade you two axes for that gold.", "intent": "OFFER", "topic": "TRADE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Have my seat by the fire, Tova.", "intent": "OFFER", "topic": "HOME", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.4, "urgency": 0.0, "names": ["Tova"], "sincerity": "SINCERE"}
{"text": "I'll teach you the forge, if you're willing.", "intent": "OFFER", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Here, share this.", "intent": "OFFER", "topic": "DRINK", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.4, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "You can bunk with us tonight, stranger.", "intent": "OFFER", "topic": "HOME", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.4, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "I'll carry half your ore, no charge.", "intent": "OFFER", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Want my spare pickaxe? Yours looks worn.", "intent": "OFFER", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Fine work at the forge today, Eitri.", "intent": "PRAISE", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.6, "urgency": 0.0, "names": ["Eitri"], "sincerity": "SINCERE"}
{"text": "That was the best ale I've had all year.", "intent": "PRAISE", "topic": "DRINK", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.7, "urgency": 0.0, "names": [], "sincerity": "JOKING"}
{"text": "You handle that axe like a master, Steinar.", "intent": "PRAISE", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.7, "urgency": 0.0, "names": ["Steinar"], "sincerity": "SINCERE"}
{"text": "Well done holding the gate, all of you.", "intent": "PRAISE", "topic": "HOME", "addressed": "GROUP", "aggression": 0.0, "valence": 0.6, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Thanks.", "intent": "PRAISE", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.5, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Your bread is the best in the settlement, Frida.", "intent": "PRAISE", "topic": "FOOD", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.7, "urgency": 0.0, "names": ["Frida"], "sincerity": "SINCERE"}
{"text": "Kolbrun's got sharp eyes, spotted that spider first.", "intent": "PRAISE", "topic": "MONSTER", "addressed": "THIRD", "aggression": 0.0, "valence": 0.6, "urgency": 0.0, "names": ["Kolbrun"], "sincerity": "SINCERE"}
{"text": "Yngvar brought back a fine haul of gold.", "intent": "PRAISE", "topic": "TREASURE", "addressed": "THIRD", "aggression": 0.0, "valence": 0.6, "urgency": 0.0, "names": ["Yngvar"], "sincerity": "SINCERE"}
{"text": "Good trade, Borin.", "intent": "PRAISE", "topic": "TRADE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.5, "urgency": 0.0, "names": ["Borin"], "sincerity": "SINCERE"}
{"text": "You thick-skulled fool, that was brilliant work, Vidar.", "intent": "PRAISE", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.6, "urgency": 0.0, "names": ["Vidar"], "sincerity": "JOKING"}
{"text": "Sorry, Runa.", "intent": "APOLOGY", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.0, "names": ["Runa"], "sincerity": "SINCERE"}
{"text": "I shouldn't have snapped at you, Halvar. My apologies.", "intent": "APOLOGY", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": ["Halvar"], "sincerity": "SINCERE"}
{"text": "Forgive me for being late to the forge, Eitri.", "intent": "APOLOGY", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.0, "names": ["Eitri"], "sincerity": "SINCERE"}
{"text": "My mistake.", "intent": "APOLOGY", "topic": "TREASURE", "addressed": "NONE", "aggression": 0.0, "valence": 0.1, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Sorry about Kolbrun's pickaxe, I'll fix it for her.", "intent": "APOLOGY", "topic": "WEAPON", "addressed": "THIRD", "aggression": 0.0, "valence": 0.2, "urgency": 0.0, "names": ["Kolbrun"], "sincerity": "SINCERE"}
{"text": "I owe you an apology, Ingrid.", "intent": "APOLOGY", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.3, "urgency": 0.0, "names": ["Ingrid"], "sincerity": "SINCERE"}
{"text": "Didn't mean to spill your ale, truly.", "intent": "APOLOGY", "topic": "DRINK", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "I'll mend the mess at the farm, I promise.", "intent": "APOLOGY", "topic": "WORK", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Nice swing, genius.", "intent": "INSULT", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.5, "valence": -0.6, "urgency": 0.0, "names": [], "sincerity": "SARCASTIC"}
{"text": "Brokk's ore looks like a goblin dug it.", "intent": "INSULT", "topic": "MINE", "addressed": "THIRD", "aggression": 0.5, "valence": -0.5, "urgency": 0.0, "names": ["Brokk"], "sincerity": "SINCERE"}
{"text": "Your beard's the only sharp thing about you.", "intent": "INSULT", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.4, "valence": -0.5, "urgency": 0.0, "names": [], "sincerity": "SARCASTIC"}
{"text": "That blade couldn't cut warm butter, Orm.", "intent": "INSULT", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.4, "valence": -0.4, "urgency": 0.0, "names": ["Orm"], "sincerity": "SINCERE"}
{"text": "You fight like a drunk goat, Hrolf.", "intent": "INSULT", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.5, "valence": -0.5, "urgency": 0.0, "names": ["Hrolf"], "sincerity": "SINCERE"}
{"text": "Even the goblin trader haggles better than you, Hrolf.", "intent": "INSULT", "topic": "TRADE", "addressed": "LISTENER", "aggression": 0.4, "valence": -0.4, "urgency": 0.0, "names": ["Hrolf"], "sincerity": "SARCASTIC"}
{"text": "Your bread's harder than the ore you mine, Tova.", "intent": "INSULT", "topic": "FOOD", "addressed": "LISTENER", "aggression": 0.3, "valence": -0.4, "urgency": 0.0, "names": ["Tova"], "sincerity": "SARCASTIC"}
{"text": "Brave talk from Hrolf, for someone who runs from spiders.", "intent": "INSULT", "topic": "MONSTER", "addressed": "THIRD", "aggression": 0.4, "valence": -0.4, "urgency": 0.0, "names": ["Hrolf"], "sincerity": "SINCERE"}
{"text": "Some clan you turned out to be.", "intent": "INSULT", "topic": "CLAN", "addressed": "LISTENER", "aggression": 0.4, "valence": -0.5, "urgency": 0.0, "names": [], "sincerity": "SARCASTIC"}
{"text": "It would be a shame if your forge caught fire.", "intent": "THREAT", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.3, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Cross me again and you'll wish you hadn't, Sindri.", "intent": "THREAT", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.7, "valence": -0.5, "urgency": 0.3, "names": ["Sindri"], "sincerity": "SINCERE"}
{"text": "Careful, or you'll end up in the lava.", "intent": "THREAT", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.3, "urgency": 0.5, "names": [], "sincerity": "SINCERE"}
{"text": "Touch my ale again and lose the hand.", "intent": "THREAT", "topic": "DRINK", "addressed": "LISTENER", "aggression": 0.7, "valence": -0.4, "urgency": 0.3, "names": [], "sincerity": "SINCERE"}
{"text": "One more trick like that, goblin, and I'll bar the gate on you.", "intent": "THREAT", "topic": "TRADE", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.4, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "I'll have your axe and your pride, Vidar.", "intent": "THREAT", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.4, "urgency": 0.2, "names": ["Vidar"], "sincerity": "SINCERE"}
{"text": "Keep talking.", "intent": "THREAT", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.4, "urgency": 0.3, "names": [], "sincerity": "SINCERE"}
{"text": "Might be a shame if Orm's ore went missing one night.", "intent": "THREAT", "topic": "MINE", "addressed": "THIRD", "aggression": 0.5, "valence": -0.3, "urgency": 0.2, "names": ["Orm"], "sincerity": "SINCERE"}
{"text": "Set foot in our mine again and you won't walk out.", "intent": "THREAT", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.8, "valence": -0.6, "urgency": 0.4, "names": [], "sincerity": "SINCERE"}
{"text": "Careful, the lava is close.", "intent": "WARNING", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.7, "names": [], "sincerity": "SINCERE"}
{"text": "Creeper!", "intent": "WARNING", "topic": "MONSTER", "addressed": "GROUP", "aggression": 0.1, "valence": 0.1, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Watch the edge, the tunnel drops off there.", "intent": "WARNING", "topic": "MINE", "addressed": "NONE", "aggression": 0.0, "valence": 0.2, "urgency": 0.6, "names": [], "sincerity": "SINCERE"}
{"text": "Zombies! Bar the gate!", "intent": "WARNING", "topic": "MONSTER", "addressed": "GROUP", "aggression": 0.1, "valence": 0.1, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Mind Skadi near the forge, she's careless with the coals.", "intent": "WARNING", "topic": "FORGE", "addressed": "THIRD", "aggression": 0.0, "valence": 0.2, "urgency": 0.5, "names": ["Skadi"], "sincerity": "SINCERE"}
{"text": "Spiders in the lower shaft, Gudrun, stay clear.", "intent": "WARNING", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.7, "names": ["Gudrun"], "sincerity": "SINCERE"}
{"text": "That crate of ore looks ready to topple, Steinar.", "intent": "WARNING", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.1, "urgency": 0.5, "names": ["Steinar"], "sincerity": "SINCERE"}
{"text": "Don't trust that goblin trader with your gold.", "intent": "WARNING", "topic": "TRADE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.0, "urgency": 0.4, "names": [], "sincerity": "SINCERE"}
{"text": "The bridge planks are rotten, step careful.", "intent": "WARNING", "topic": "HOME", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.2, "urgency": 0.6, "names": [], "sincerity": "SINCERE"}
{"text": "Where did my ore go, Brokk?", "intent": "ACCUSE", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.4, "valence": -0.3, "urgency": 0.3, "names": ["Brokk"], "sincerity": "SINCERE"}
{"text": "Don't trust Sindri, he cheats at dice.", "intent": "ACCUSE", "topic": "NONE", "addressed": "THIRD", "aggression": 0.3, "valence": -0.4, "urgency": 0.1, "names": ["Sindri"], "sincerity": "SINCERE"}
{"text": "You've been skimming gold from the treasury, Orm.", "intent": "ACCUSE", "topic": "TREASURE", "addressed": "LISTENER", "aggression": 0.5, "valence": -0.4, "urgency": 0.3, "names": ["Orm"], "sincerity": "SINCERE"}
{"text": "Whose bright idea was it to let the fire go out?", "intent": "ACCUSE", "topic": "FORGE", "addressed": "GROUP", "aggression": 0.4, "valence": -0.3, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "You broke my pickaxe and blamed the goblin, Yngvar.", "intent": "ACCUSE", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.4, "valence": -0.4, "urgency": 0.1, "names": ["Yngvar"], "sincerity": "SINCERE"}
{"text": "Brynja's been trading with that goblin behind our backs.", "intent": "ACCUSE", "topic": "TRADE", "addressed": "THIRD", "aggression": 0.4, "valence": -0.4, "urgency": 0.2, "names": ["Brynja"], "sincerity": "SINCERE"}
{"text": "Skadi knew the spiders were nesting and said nothing.", "intent": "ACCUSE", "topic": "MONSTER", "addressed": "THIRD", "aggression": 0.5, "valence": -0.4, "urgency": 0.3, "names": ["Skadi"], "sincerity": "SINCERE"}
{"text": "Torvi's been eating from the clan stores at night.", "intent": "ACCUSE", "topic": "FOOD", "addressed": "THIRD", "aggression": 0.3, "valence": -0.3, "urgency": 0.1, "names": ["Torvi"], "sincerity": "SINCERE"}
{"text": "You let Dvalin take the blame for your mistake.", "intent": "ACCUSE", "topic": "CLAN", "addressed": "THIRD", "aggression": 0.4, "valence": -0.4, "urgency": 0.2, "names": ["Dvalin"], "sincerity": "SINCERE"}
