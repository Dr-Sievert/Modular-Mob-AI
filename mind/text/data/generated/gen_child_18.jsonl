{"text": "So cold today.", "intent": "SMALLTALK", "topic": "NONE", "addressed": "NONE", "aggression": 0.0, "valence": 0.0, "urgency": 0.0, "names": [], "sincerity": "SINCERE"}
{"text": "Brokk says it's freezing down in the mine.", "intent": "SMALLTALK", "topic": "MINE", "addressed": "THIRD", "aggression": 0.0, "valence": 0.0, "urgency": 0.0, "names": ["Brokk"], "sincerity": "SINCERE"}
