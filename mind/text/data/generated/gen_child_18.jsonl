{"text": "Dvalin's slow.", "intent": "INSULT", "topic": "WORK", "addressed": "THIRD", "aggression": 0.3, "valence": -0.3, "urgency": 0.0, "names": ["Dvalin"], "sincerity": "SINCERE"}
