{"text": "I know where you sleep, and I have a wooden sword.", "intent": "THREAT", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.3, "valence": 0.1, "urgency": 0.1, "names": [], "sincerity": "JOKING"}
