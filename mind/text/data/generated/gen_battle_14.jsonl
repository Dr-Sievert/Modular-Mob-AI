{"text": "Creeper!", "intent": "WARNING", "topic": "MONSTER", "addressed": "GROUP", "aggression": 0.1, "valence": 0.0, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Behind you, a zombie!", "intent": "WARNING", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.2, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Spiders dropping from the ridge, watch the flank!", "intent": "WARNING", "topic": "MONSTER", "addressed": "GROUP", "aggression": 0.1, "valence": 0.0, "urgency": 0.9, "names": [], "sincerity": "SINCERE"}
{"text": "Careful, the lava's rising fast, Borin!", "intent": "WARNING", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.3, "urgency": 0.7, "names": ["Borin"], "sincerity": "SINCERE"}
{"text": "Watch the ridge, more of them coming!", "intent": "WARNING", "topic": "MONSTER", "addressed": "GROUP", "aggression": 0.1, "valence": 0.0, "urgency": 0.9, "names": [], "sincerity": "SINCERE"}
{"text": "Skadi, your shield arm, a spider's on it!", "intent": "WARNING", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.3, "urgency": 1.0, "names": ["Skadi"], "sincerity": "SINCERE"}
{"text": "The forge roof's caving, get clear!", "intent": "WARNING", "topic": "FORGE", "addressed": "GROUP", "aggression": 0.1, "valence": 0.0, "urgency": 0.9, "names": [], "sincerity": "SINCERE"}
{"text": "Zombies at the farm gate, Halvar!", "intent": "WARNING", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.2, "urgency": 0.9, "names": ["Halvar"], "sincerity": "SINCERE"}
{"text": "Mind the pit behind you!", "intent": "WARNING", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.2, "urgency": 0.8, "names": [], "sincerity": "SINCERE"}
{"text": "Mind the lava right behind your boots!", "intent": "WARNING", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.3, "urgency": 0.8, "names": [], "sincerity": "SINCERE"}
{"text": "Trolls at the eastern wall, sound the horn!", "intent": "WARNING", "topic": "MONSTER", "addressed": "GROUP", "aggression": 0.1, "valence": 0.0, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Your axe is slipping, Torvi, tighten your grip!", "intent": "WARNING", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.3, "urgency": 0.7, "names": ["Torvi"], "sincerity": "SINCERE"}
{"text": "The bridge planks are cracking, get off it!", "intent": "WARNING", "topic": "NONE", "addressed": "GROUP", "aggression": 0.1, "valence": 0.0, "urgency": 0.9, "names": [], "sincerity": "SINCERE"}
{"text": "Fire arrows incoming, shields up!", "intent": "WARNING", "topic": "WEAPON", "addressed": "GROUP", "aggression": 0.1, "valence": 0.0, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "It would be a shame if your forge caught fire, Brokk.", "intent": "THREAT", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.4, "urgency": 0.3, "names": ["Brokk"], "sincerity": "SINCERE"}
{"text": "Take one more step and you'll join the lava, goblin.", "intent": "THREAT", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.8, "valence": -0.6, "urgency": 0.6, "names": [], "sincerity": "SINCERE"}
{"text": "Touch my axe again and I'll take your hand.", "intent": "THREAT", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.7, "valence": -0.5, "urgency": 0.4, "names": [], "sincerity": "SINCERE"}
{"text": "Run now, Sindri, or feel my hammer.", "intent": "THREAT", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.7, "valence": -0.5, "urgency": 0.5, "names": ["Sindri"], "sincerity": "SINCERE"}
{"text": "Come closer, worm, and see what dwarves do to vermin.", "intent": "THREAT", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.8, "valence": -0.6, "urgency": 0.5, "names": [], "sincerity": "SINCERE"}
{"text": "Cross that line and you won't walk back to your nest.", "intent": "THREAT", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.7, "valence": -0.5, "urgency": 0.4, "names": [], "sincerity": "SINCERE"}
{"text": "I'll hang you from the gate myself, Orm, if you flee again.", "intent": "THREAT", "topic": "CLAN", "addressed": "LISTENER", "aggression": 0.7, "valence": -0.5, "urgency": 0.3, "names": ["Orm"], "sincerity": "SINCERE"}
{"text": "Say that again and it'll be your last breath.", "intent": "THREAT", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.8, "valence": -0.6, "urgency": 0.5, "names": [], "sincerity": "SINCERE"}
{"text": "It would be wise not to test my patience today.", "intent": "THREAT", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.3, "urgency": 0.3, "names": [], "sincerity": "SINCERE"}
{"text": "One more coin short, Sindri, and the goblin trade ends in blood.", "intent": "THREAT", "topic": "TRADE", "addressed": "LISTENER", "aggression": 0.7, "valence": -0.5, "urgency": 0.3, "names": ["Sindri"], "sincerity": "SINCERE"}
{"text": "Move!", "intent": "COMMAND", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.5, "valence": 0.0, "urgency": 0.9, "names": [], "sincerity": "SINCERE"}
{"text": "Everyone to the gate, this instant!", "intent": "COMMAND", "topic": "HOME", "addressed": "GROUP", "aggression": 0.4, "valence": 0.0, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Grab your axes, all of you, to the wall!", "intent": "COMMAND", "topic": "WEAPON", "addressed": "GROUP", "aggression": 0.4, "valence": 0.0, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Hold the line, Dagna!", "intent": "COMMAND", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.4, "valence": 0.2, "urgency": 0.9, "names": ["Dagna"], "sincerity": "SINCERE"}
{"text": "Fall back to the great hall!", "intent": "COMMAND", "topic": "HOME", "addressed": "GROUP", "aggression": 0.3, "valence": 0.0, "urgency": 0.9, "names": [], "sincerity": "SINCERE"}
{"text": "Get the pikes, the gate's breaking!", "intent": "COMMAND", "topic": "WEAPON", "addressed": "GROUP", "aggression": 0.4, "valence": 0.0, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Steinar, flank left, now!", "intent": "COMMAND", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.4, "valence": 0.1, "urgency": 1.0, "names": ["Steinar"], "sincerity": "SINCERE"}
{"text": "Bar the doors and douse the torches!", "intent": "COMMAND", "topic": "HOME", "addressed": "GROUP", "aggression": 0.3, "valence": 0.0, "urgency": 0.9, "names": [], "sincerity": "SINCERE"}
{"text": "Sound the horn, Vidar, call the miners up!", "intent": "COMMAND", "topic": "CLAN", "addressed": "LISTENER", "aggression": 0.3, "valence": 0.1, "urgency": 0.9, "names": ["Vidar"], "sincerity": "SINCERE"}
{"text": "Shields up!", "intent": "COMMAND", "topic": "WEAPON", "addressed": "GROUP", "aggression": 0.4, "valence": 0.0, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Get to cover, all of you, arrows incoming!", "intent": "COMMAND", "topic": "WEAPON", "addressed": "GROUP", "aggression": 0.3, "valence": 0.0, "urgency": 1.0, "names": [], "sincerity": "SINCERE"}
{"text": "Drop the ore sacks and pick up a blade, Gudrun!", "intent": "COMMAND", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.4, "valence": 0.1, "urgency": 0.9, "names": ["Gudrun"], "sincerity": "SINCERE"}
{"text": "Hold!", "intent": "COMMAND", "topic": "NONE", "addressed": "GROUP", "aggression": 0.4, "valence": 0.0, "urgency": 0.8, "names": [], "sincerity": "SINCERE"}
{"text": "Push them back to the mine mouth!", "intent": "COMMAND", "topic": "MINE", "addressed": "GROUP", "aggression": 0.4, "valence": 0.0, "urgency": 0.9, "names": [], "sincerity": "SINCERE"}
{"text": "Where did my ore go, Brokk?", "intent": "ACCUSE", "topic": "MINE", "addressed": "LISTENER", "aggression": 0.4, "valence": -0.3, "urgency": 0.3, "names": ["Brokk"], "sincerity": "SINCERE"}
{"text": "Don't trust Sindri, he sells our secrets to the goblin trader.", "intent": "ACCUSE", "topic": "TRADE", "addressed": "THIRD", "aggression": 0.5, "valence": -0.4, "urgency": 0.4, "names": ["Sindri"], "sincerity": "SINCERE"}
{"text": "You let the gate stand open, Halvar, this is on you!", "intent": "ACCUSE", "topic": "HOME", "addressed": "LISTENER", "aggression": 0.5, "valence": -0.4, "urgency": 0.6, "names": ["Halvar"], "sincerity": "SINCERE"}
{"text": "It was Kolbrun who dropped her post, not me!", "intent": "ACCUSE", "topic": "CLAN", "addressed": "THIRD", "aggression": 0.4, "valence": -0.3, "urgency": 0.3, "names": ["Kolbrun"], "sincerity": "SINCERE"}
{"text": "You froze at the wall, Dvalin, and Ingrid nearly paid for it!", "intent": "ACCUSE", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.5, "valence": -0.4, "urgency": 0.4, "names": ["Dvalin", "Ingrid"], "sincerity": "SINCERE"}
{"text": "Whose watch was this, Vidar, who let the spiders through?", "intent": "ACCUSE", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.5, "valence": -0.3, "urgency": 0.6, "names": ["Vidar"], "sincerity": "SINCERE"}
{"text": "You sold us out to the goblins, didn't you, Orm?", "intent": "ACCUSE", "topic": "TRADE", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.5, "urgency": 0.4, "names": ["Orm"], "sincerity": "SINCERE"}
{"text": "Ragna knows more about this ambush than she's saying.", "intent": "ACCUSE", "topic": "CLAN", "addressed": "THIRD", "aggression": 0.4, "valence": -0.3, "urgency": 0.3, "names": ["Ragna"], "sincerity": "SINCERE"}
{"text": "Dvalin broke ranks first, don't blame the line for falling.", "intent": "ACCUSE", "topic": "WEAPON", "addressed": "THIRD", "aggression": 0.5, "valence": -0.4, "urgency": 0.5, "names": ["Dvalin"], "sincerity": "SINCERE"}
{"text": "Someone left the forge unguarded, Eitri, and I think it was you!", "intent": "ACCUSE", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.5, "valence": -0.4, "urgency": 0.4, "names": ["Eitri"], "sincerity": "SINCERE"}
{"text": "Nice swing, genius, you nearly hit me instead.", "intent": "INSULT", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.5, "valence": -0.5, "urgency": 0.2, "names": [], "sincerity": "SARCASTIC"}
{"text": "Is that the best you've got, worm?", "intent": "INSULT", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.5, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Hrolf fights like a startled goat, doesn't he?", "intent": "INSULT", "topic": "WEAPON", "addressed": "THIRD", "aggression": 0.2, "valence": 0.3, "urgency": 0.1, "names": ["Hrolf"], "sincerity": "JOKING"}
{"text": "Crawl back to your hole, you overgrown spider!", "intent": "INSULT", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.5, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Even the goats hit harder than Yngvar does.", "intent": "INSULT", "topic": "WEAPON", "addressed": "THIRD", "aggression": 0.5, "valence": -0.4, "urgency": 0.1, "names": ["Yngvar"], "sincerity": "SARCASTIC"}
{"text": "That goblin trader has the courage of a beetle.", "intent": "INSULT", "topic": "TRADE", "addressed": "THIRD", "aggression": 0.4, "valence": -0.4, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Ugly brute, is that all you've learned to do, swing wide?", "intent": "INSULT", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.6, "valence": -0.5, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Your battle cry sounds like a dying goose, Borin.", "intent": "INSULT", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.4, "valence": -0.3, "urgency": 0.1, "names": ["Borin"], "sincerity": "SINCERE"}
{"text": "Weak. Pathetic. Is this truly a zombie horde?", "intent": "INSULT", "topic": "MONSTER", "addressed": "GROUP", "aggression": 0.6, "valence": -0.5, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Real brave, hiding behind Dagna the whole fight.", "intent": "INSULT", "topic": "WEAPON", "addressed": "THIRD", "aggression": 0.5, "valence": -0.5, "urgency": 0.1, "names": ["Dagna"], "sincerity": "SARCASTIC"}
{"text": "You reckless fool, that was the finest strike I've seen!", "intent": "PRAISE", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.2, "valence": 0.7, "urgency": 0.1, "names": [], "sincerity": "JOKING"}
{"text": "Well fought, Brynja, the line held because of you!", "intent": "PRAISE", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.8, "urgency": 0.1, "names": ["Brynja"], "sincerity": "SINCERE"}
{"text": "Fine work at the forge, Eitri, those blades held true.", "intent": "PRAISE", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.7, "urgency": 0.1, "names": ["Eitri"], "sincerity": "SINCERE"}
{"text": "That was a mighty blow, Frida!", "intent": "PRAISE", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.8, "urgency": 0.1, "names": ["Frida"], "sincerity": "SINCERE"}
{"text": "Well struck!", "intent": "PRAISE", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.7, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "The whole clan fought bravely tonight!", "intent": "PRAISE", "topic": "CLAN", "addressed": "GROUP", "aggression": 0.1, "valence": 0.8, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Steinar held the gate alone against three zombies, respect.", "intent": "PRAISE", "topic": "MONSTER", "addressed": "THIRD", "aggression": 0.1, "valence": 0.7, "urgency": 0.1, "names": ["Steinar"], "sincerity": "SINCERE"}
{"text": "Good aim, Runa, that spider never saw it coming.", "intent": "PRAISE", "topic": "MONSTER", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.7, "urgency": 0.1, "names": ["Runa"], "sincerity": "SINCERE"}
{"text": "Well met, Borin, glad you're still standing!", "intent": "GREET", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.7, "urgency": 0.2, "names": ["Borin"], "sincerity": "SINCERE"}
{"text": "Good to see the whole clan made it through the night!", "intent": "GREET", "topic": "CLAN", "addressed": "GROUP", "aggression": 0.1, "valence": 0.8, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Hail, kin, the mine crew answered the horn!", "intent": "GREET", "topic": "CLAN", "addressed": "GROUP", "aggression": 0.1, "valence": 0.6, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Welcome back to the hall, Frida!", "intent": "GREET", "topic": "HOME", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.7, "urgency": 0.1, "names": ["Frida"], "sincerity": "SINCERE"}
{"text": "Raise a mug, we're alive!", "intent": "GREET", "topic": "DRINK", "addressed": "GROUP", "aggression": 0.1, "valence": 0.7, "urgency": 0.1, "names": [], "sincerity": "JOKING"}
{"text": "Well met.", "intent": "GREET", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.5, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Good to see you standing, stranger.", "intent": "GREET", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.5, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Fall back and live, we'll drink to this later!", "intent": "FAREWELL", "topic": "DRINK", "addressed": "GROUP", "aggression": 0.1, "valence": 0.5, "urgency": 0.4, "names": [], "sincerity": "JOKING"}
{"text": "Fare well, Steinar, hold the rear!", "intent": "FAREWELL", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.6, "urgency": 0.3, "names": ["Steinar"], "sincerity": "SINCERE"}
{"text": "Off to the gate, don't wait for me!", "intent": "FAREWELL", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.4, "urgency": 0.4, "names": [], "sincerity": "SINCERE"}
{"text": "See you at the hall, if the gods will it!", "intent": "FAREWELL", "topic": "HOME", "addressed": "GROUP", "aggression": 0.1, "valence": 0.4, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Farewell, Ragna, may your axe stay sharp!", "intent": "FAREWELL", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.6, "urgency": 0.2, "names": ["Ragna"], "sincerity": "SINCERE"}
{"text": "Go, warn the clan, I'll hold here!", "intent": "FAREWELL", "topic": "CLAN", "addressed": "LISTENER", "aggression": 0.2, "valence": 0.4, "urgency": 0.7, "names": [], "sincerity": "SINCERE"}
{"text": "Farewell.", "intent": "FAREWELL", "topic": "NONE", "addressed": "NONE", "aggression": 0.1, "valence": 0.3, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "I could kill for a pint right now.", "intent": "SMALLTALK", "topic": "DRINK", "addressed": "NONE", "aggression": 0.1, "valence": 0.3, "urgency": 0.1, "names": [], "sincerity": "JOKING"}
{"text": "Bread would taste good after all this.", "intent": "SMALLTALK", "topic": "FOOD", "addressed": "NONE", "aggression": 0.0, "valence": 0.2, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "The forge hasn't stopped roaring all week, has it, Eitri?", "intent": "SMALLTALK", "topic": "WORK", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.1, "urgency": 0.1, "names": ["Eitri"], "sincerity": "SINCERE"}
{"text": "Wonder if there's still gold under the old shaft.", "intent": "SMALLTALK", "topic": "TREASURE", "addressed": "NONE", "aggression": 0.0, "valence": 0.1, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Ale would go down easy after this mess.", "intent": "SMALLTALK", "topic": "DRINK", "addressed": "NONE", "aggression": 0.0, "valence": 0.2, "urgency": 0.1, "names": [], "sincerity": "JOKING"}
{"text": "Haven't had a decent meal in two days.", "intent": "SMALLTALK", "topic": "FOOD", "addressed": "NONE", "aggression": 0.0, "valence": 0.0, "urgency": 0.1, "names": [], "sincerity": "JOKING"}
{"text": "Quiet moment, isn't it, Brynja, before the next wave.", "intent": "SMALLTALK", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.0, "valence": 0.1, "urgency": 0.2, "names": ["Brynja"], "sincerity": "SINCERE"}
{"text": "Never thought I'd see snow this deep in the pass.", "intent": "SMALLTALK", "topic": "NONE", "addressed": "NONE", "aggression": 0.0, "valence": 0.1, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "Feels like the whole mountain is shaking tonight.", "intent": "SMALLTALK", "topic": "NONE", "addressed": "GROUP", "aggression": 0.0, "valence": 0.0, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Well?", "intent": "QUESTION", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.2, "valence": 0.0, "urgency": 0.5, "names": [], "sincerity": "SINCERE"}
{"text": "How many are left at the wall, Vidar?", "intent": "QUESTION", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.0, "urgency": 0.6, "names": ["Vidar"], "sincerity": "SINCERE"}
{"text": "Did the miners make it to the hall, Alvis?", "intent": "QUESTION", "topic": "WORK", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.1, "urgency": 0.5, "names": ["Alvis"], "sincerity": "SINCERE"}
{"text": "Is the forge crew still trapped inside?", "intent": "QUESTION", "topic": "WORK", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.1, "urgency": 0.6, "names": [], "sincerity": "SINCERE"}
{"text": "What in the deep dark is that roar?", "intent": "QUESTION", "topic": "MONSTER", "addressed": "GROUP", "aggression": 0.1, "valence": 0.0, "urgency": 0.7, "names": [], "sincerity": "SINCERE"}
{"text": "Can the clan hold one more hour?", "intent": "QUESTION", "topic": "CLAN", "addressed": "GROUP", "aggression": 0.1, "valence": 0.1, "urgency": 0.5, "names": [], "sincerity": "SINCERE"}
{"text": "Did the goblin trader run when the fighting started?", "intent": "QUESTION", "topic": "TRADE", "addressed": "THIRD", "aggression": 0.2, "valence": -0.1, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Is the gold vault still sealed?", "intent": "QUESTION", "topic": "TREASURE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.0, "urgency": 0.4, "names": [], "sincerity": "SINCERE"}
{"text": "Where's the reinforcements Halvar promised us?", "intent": "QUESTION", "topic": "NONE", "addressed": "THIRD", "aggression": 0.2, "valence": -0.1, "urgency": 0.5, "names": ["Halvar"], "sincerity": "SINCERE"}
{"text": "Pass me another axe, Grimhild, mine's chipped!", "intent": "REQUEST", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.2, "valence": 0.1, "urgency": 0.6, "names": ["Grimhild"], "sincerity": "SINCERE"}
{"text": "Cover me while I reload, Brynja!", "intent": "REQUEST", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.2, "valence": 0.2, "urgency": 0.7, "names": ["Brynja"], "sincerity": "SINCERE"}
{"text": "Toss me a shield, quick!", "intent": "REQUEST", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.2, "valence": 0.1, "urgency": 0.7, "names": [], "sincerity": "SINCERE"}
{"text": "Bring water, my throat's raw from shouting.", "intent": "REQUEST", "topic": "DRINK", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.1, "urgency": 0.4, "names": [], "sincerity": "SINCERE"}
{"text": "Save me some bread if we live through this.", "intent": "REQUEST", "topic": "FOOD", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.2, "urgency": 0.2, "names": [], "sincerity": "JOKING"}
{"text": "Help me carry the wounded to the hall, Gudrun.", "intent": "REQUEST", "topic": "WORK", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.2, "urgency": 0.6, "names": ["Gudrun"], "sincerity": "SINCERE"}
{"text": "Grab whatever gold you can and run.", "intent": "REQUEST", "topic": "TREASURE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.0, "urgency": 0.6, "names": [], "sincerity": "JOKING"}
{"text": "Someone light more torches, I can't see.", "intent": "REQUEST", "topic": "NONE", "addressed": "GROUP", "aggression": 0.1, "valence": 0.0, "urgency": 0.6, "names": [], "sincerity": "SINCERE"}
{"text": "I'll guard this door, go help the others!", "intent": "OFFER", "topic": "HOME", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.4, "urgency": 0.6, "names": [], "sincerity": "SINCERE"}
{"text": "Take my spare axe, Tova!", "intent": "OFFER", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.5, "urgency": 0.4, "names": ["Tova"], "sincerity": "SINCERE"}
{"text": "Let me forge new blade edges tonight, if we survive.", "intent": "OFFER", "topic": "FORGE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.3, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "Share my rations, you look starved.", "intent": "OFFER", "topic": "FOOD", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.5, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "The treasure chest isn't heavy, I've got it.", "intent": "OFFER", "topic": "TREASURE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.3, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "I'll take the next watch, go rest, Kolbrun.", "intent": "OFFER", "topic": "WORK", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.5, "urgency": 0.2, "names": ["Kolbrun"], "sincerity": "SINCERE"}
{"text": "Here, take my shield arm's spot.", "intent": "OFFER", "topic": "WEAPON", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.4, "urgency": 0.4, "names": [], "sincerity": "SINCERE"}
{"text": "Sorry, Runa.", "intent": "APOLOGY", "topic": "NONE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.3, "urgency": 0.1, "names": ["Runa"], "sincerity": "SINCERE"}
{"text": "I shouldn't have frozen at the gate, forgive me.", "intent": "APOLOGY", "topic": "WORK", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.3, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "I broke formation, it won't happen again, forgive me.", "intent": "APOLOGY", "topic": "WORK", "addressed": "GROUP", "aggression": 0.1, "valence": 0.3, "urgency": 0.2, "names": [], "sincerity": "SINCERE"}
{"text": "My apologies for the burnt bread, Ingrid, the forge ran wild.", "intent": "APOLOGY", "topic": "FOOD", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.3, "urgency": 0.1, "names": ["Ingrid"], "sincerity": "SINCERE"}
{"text": "Forgive me, clan, I should have sounded the horn sooner.", "intent": "APOLOGY", "topic": "CLAN", "addressed": "GROUP", "aggression": 0.1, "valence": 0.3, "urgency": 0.3, "names": [], "sincerity": "SINCERE"}
{"text": "Sorry about your share of the treasure, it's gone.", "intent": "APOLOGY", "topic": "TREASURE", "addressed": "LISTENER", "aggression": 0.1, "valence": 0.2, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
{"text": "I'm sorry.", "intent": "APOLOGY", "topic": "NONE", "addressed": "NONE", "aggression": 0.1, "valence": 0.2, "urgency": 0.1, "names": [], "sincerity": "SINCERE"}
