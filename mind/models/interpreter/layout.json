{
  "model": "interpreter",
  "schema_id": "dialogue-clf-v2",
  "dims": {
    "buckets": 65536,
    "embedding": 32,
    "side": 20,
    "fc1_in": 52,
    "hidden": 64,
    "heads": {
      "intent": 13,
      "topic": 12,
      "addressed": 4,
      "sincerity": 3,
      "floats": 3
    }
  },
  "hash": {
    "name": "FNV-1a, 32-bit",
    "offset_basis": "0x811c9dc5",
    "prime": "0x01000193",
    "input": "the UTF-8 bytes of the feature string",
    "step": "h ^= byte; h = (h * prime) & 0xffffffff",
    "fold": "bucket = h & (buckets - 1), buckets is a power of two",
    "known_vectors": {
      "": "0x811c9dc5",
      "a": "0xe40c292c",
      "foobar": "0xbf9cf968"
    }
  },
  "tokenizer": {
    "lowercase": "ASCII only: A-Z -> a-z (+32); all other characters unchanged",
    "quote_fold": {
      "‘": "'",
      "’": "'",
      "“": "\"",
      "”": "\""
    },
    "separators": "\t\n\u000b\f\r !\"#$%&()*+,-./:;<=>?@[\\]^_`{|}~–—…",
    "apostrophe": "kept inside tokens, stripped from both ends of a token",
    "features": [
      "word unigram: 'w:' + token",
      "word bigram: 'b:' + token[i] + ' ' + token[i+1]",
      "char trigram: 'c:' + each 3-window of '<' + token + '>'",
      "first word: '^first=' + tokens[0]",
      "last word: '$last=' + tokens[-1]"
    ],
    "feature_order": "unigrams, bigrams, trigrams, first word, last word (the bag is a sum, so the order is documentation only)",
    "empty_text_bucket": 40389
  },
  "side_features": {
    "dim": 20,
    "order": [
      "log1p_word_count",
      "log1p_char_count",
      "caps_share",
      "exclamation_count",
      "question_count",
      "has_ellipsis",
      "prev_intent=GREET",
      "prev_intent=FAREWELL",
      "prev_intent=SMALLTALK",
      "prev_intent=QUESTION",
      "prev_intent=REQUEST",
      "prev_intent=COMMAND",
      "prev_intent=OFFER",
      "prev_intent=PRAISE",
      "prev_intent=APOLOGY",
      "prev_intent=INSULT",
      "prev_intent=THREAT",
      "prev_intent=WARNING",
      "prev_intent=ACCUSE",
      "prev_intent=unknown"
    ],
    "placement": "concatenated onto the end of relu(embedding sum), so fc1's input is [dim embedding columns, then these SIDE_DIM columns]",
    "computed_from": "the raw line, before any lowercasing or quote folding",
    "fields": {
      "log1p_word_count": "ln(1 + number of tokens from tokenize(text))",
      "log1p_char_count": "ln(1 + number of characters in the raw line)",
      "caps_share": "ASCII A-Z count / ASCII letter count; 0.0 when the line has no ASCII letters",
      "exclamation_count": "raw count of '!' characters, not capped",
      "question_count": "raw count of '?' characters, not capped",
      "has_ellipsis": "1.0 when two or more '.' characters are adjacent anywhere in the raw line ('..' or '...'), else 0.0",
      "prev_intent": "14-way one-hot at offset 6: the 13 intents in label order, then 'unknown'. A caller that supplies nothing, or a string that is not exactly one of the 13 intents, gets 'unknown'."
    },
    "prev_intent_labels": [
      "GREET",
      "FAREWELL",
      "SMALLTALK",
      "QUESTION",
      "REQUEST",
      "COMMAND",
      "OFFER",
      "PRAISE",
      "APOLOGY",
      "INSULT",
      "THREAT",
      "WARNING",
      "ACCUSE",
      "unknown"
    ],
    "prev_intent_offset": 6,
    "prev_intent_in_training_data": "always 'unknown': no corpus row carries a prev_intent field yet, so the other 13 columns of fc1 have never had a gradient and supplying one shifts the output by an untrained amount"
  },
  "labels": {
    "intent": [
      "GREET",
      "FAREWELL",
      "SMALLTALK",
      "QUESTION",
      "REQUEST",
      "COMMAND",
      "OFFER",
      "PRAISE",
      "APOLOGY",
      "INSULT",
      "THREAT",
      "WARNING",
      "ACCUSE"
    ],
    "topic": [
      "FORGE",
      "MINE",
      "TREASURE",
      "FOOD",
      "DRINK",
      "HOME",
      "WEAPON",
      "WORK",
      "CLAN",
      "MONSTER",
      "TRADE",
      "NONE"
    ],
    "addressed": [
      "LISTENER",
      "THIRD",
      "GROUP",
      "NONE"
    ],
    "sincerity": [
      "SINCERE",
      "SARCASTIC",
      "JOKING"
    ],
    "floats": [
      "aggression",
      "valence",
      "urgency"
    ],
    "float_activations": [
      "sigmoid",
      "tanh",
      "sigmoid"
    ],
    "names": [
      "Alvis",
      "Borin",
      "Brokk",
      "Brynja",
      "Dagna",
      "Dvalin",
      "Eitri",
      "Frida",
      "Grimhild",
      "Gudrun",
      "Halvar",
      "Hrolf",
      "Ingrid",
      "Kolbrun",
      "Orm",
      "Ragna",
      "Runa",
      "Sindri",
      "Skadi",
      "Steinar",
      "Torvi",
      "Tova",
      "Vidar",
      "Yngvar"
    ]
  },
  "optional_labels": [
    "sincerity"
  ],
  "forward": [
    "h = relu(sum of emb[b] for b in buckets(text))          # dim floats",
    "s = side_features(raw text, prev_intent)                # side floats, see side_features",
    "h = relu(concat(h, s) @ fc1.weight.T + fc1.bias)",
    "intent    = argmax(h @ head_intent.weight.T + head_intent.bias)",
    "topic     = argmax(h @ head_topic.weight.T + head_topic.bias)",
    "addressed = argmax(h @ head_addressed.weight.T + head_addressed.bias)",
    "sincerity = argmax(h @ head_sincerity.weight.T + head_sincerity.bias)",
    "floats    = [sigmoid, tanh, sigmoid] of (h @ head_floats.weight.T + head_floats.bias)",
    "names     = exact matches of the name pool in the raw text, not predicted"
  ],
  "arrays": [
    {
      "name": "emb.weight",
      "shape": [
        65536,
        32
      ],
      "dtype": "float32",
      "role": "embedding bag rows, (buckets, dim), summed over a text's buckets"
    },
    {
      "name": "fc1.weight",
      "shape": [
        64,
        52
      ],
      "dtype": "float32",
      "role": "hidden layer, (hidden, dim + side): the first `dim` columns take the embedding sum, the rest take the side vector"
    },
    {
      "name": "fc1.bias",
      "shape": [
        64
      ],
      "dtype": "float32",
      "role": "hidden layer bias, (hidden,)"
    },
    {
      "name": "head_intent.weight",
      "shape": [
        13,
        64
      ],
      "dtype": "float32",
      "role": "intent logits, (13, hidden)"
    },
    {
      "name": "head_intent.bias",
      "shape": [
        13
      ],
      "dtype": "float32",
      "role": "(13,)"
    },
    {
      "name": "head_topic.weight",
      "shape": [
        12,
        64
      ],
      "dtype": "float32",
      "role": "topic logits, (12, hidden)"
    },
    {
      "name": "head_topic.bias",
      "shape": [
        12
      ],
      "dtype": "float32",
      "role": "(12,)"
    },
    {
      "name": "head_addressed.weight",
      "shape": [
        4,
        64
      ],
      "dtype": "float32",
      "role": "addressed logits, (4, hidden)"
    },
    {
      "name": "head_addressed.bias",
      "shape": [
        4
      ],
      "dtype": "float32",
      "role": "(4,)"
    },
    {
      "name": "head_sincerity.weight",
      "shape": [
        3,
        64
      ],
      "dtype": "float32",
      "role": "sincerity logits, (3, hidden)"
    },
    {
      "name": "head_sincerity.bias",
      "shape": [
        3
      ],
      "dtype": "float32",
      "role": "(3,)"
    },
    {
      "name": "head_floats.weight",
      "shape": [
        3,
        64
      ],
      "dtype": "float32",
      "role": "aggression/valence/urgency, (3, hidden)"
    },
    {
      "name": "head_floats.bias",
      "shape": [
        3
      ],
      "dtype": "float32",
      "role": "(3,)"
    }
  ],
  "linear_layout": "torch: weight is (out, in), y = x @ weight.T + bias"
}
