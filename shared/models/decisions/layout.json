  "forward": [
    "x = observation ++ candidate_features",
    "h = relu(x @ fc1.weight.T + fc1.bias)",
    "h = relu(h @ fc2.weight.T + fc2.bias)",
    "score = (h @ out.weight.T + out.bias)[0]"
  ],
  "arrays": [
    {
      "name": "fc1.weight",
      "shape": [
        64,
        142
      ],
      "dtype": "float32",
      "role": "first hidden layer, (hidden1, OBS_SIZE + CAND_SIZE)"
    },
    {
      "name": "fc1.bias",
      "shape": [
        64
      ],
      "dtype": "float32",
      "role": "(hidden1,)"
    },
    {
      "name": "fc2.weight",
      "shape": [
        64,
        64
      ],
      "dtype": "float32",
      "role": "second hidden layer, (hidden2, hidden1)"
    },
    {
      "name": "fc2.bias",
      "shape": [
        64
      ],
      "dtype": "float32",
      "role": "(hidden2,)"
    },
    {
      "name": "out.weight",
      "shape": [
        1,
        64
      ],
      "dtype": "float32",
      "role": "the score, (1, hidden2)"
    },
    {
      "name": "out.bias",
      "shape": [
        1
      ],
      "dtype": "float32",
      "role": "(1,)"
    }
  ],
  "linear_layout": "torch: weight is (out, in), y = x @ weight.T + bias"
}
