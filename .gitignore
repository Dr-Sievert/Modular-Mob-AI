# other
eclipse
run
# Training runs: gigabytes of rollouts, demos and checkpoints, one folder per run. A bare `runs` used to match at any
# depth and so covered all three of these at once; named one by one now that each half owns its own folder, so that a
# folder called runs somewhere unexpected is a question rather than a silence.
combat/runs/
mind/runs/
# the loaders' own run folders, made by a dev client, a dev server or a game test server
combat/mod/*/runs/
# the Java and Python setup.ps1 downloads when a machine has none of its own
combat/.tools/
# worktrees Claude Code makes for work in parallel
.claude/worktrees

# python
__pycache__
*.pyc
.venv
venv
checkpoints
logs

# the mind subproject (mind/), a pure-Python testbed with no Java in it; its runs/ is named above with the other halves'
mind/text/data/raw/
mind/text/data/dialogue_partial.jsonl
mind/text/data/generated_raw/
# trained checkpoints are regenerable; the exported weights.npz + model.json are what ships
mind/text/models/**/model.pt
mind/text/models/**/*.log
__pycache__/
.pytest_cache/
